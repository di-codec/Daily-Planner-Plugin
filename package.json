{
	"name": "daily-planner-plugin",
	"version": "2.0.0",
	"description": "Plan your day in one place: a calendar, a daily checklist and schedule, and a weekly habit tracker, all stored as plain Markdown notes.",
	"main": "main.js",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint . --ext .ts",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Diana Percatkina",
	"license": "MIT",
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^20.11.0",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"eslint": "^8.57.1",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"vitest": "^2.1.9"
	},
	"dependencies": {
		"chart.js": "^4.5.0",
		"js-yaml": "^4.1.0"
	}
}
